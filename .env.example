# Northeast Shipping & Recruitment Agency Pvt Ltd
# Environment Configuration Template

# MongoDB Database Connection
MONGODB_URI=mongodb://localhost:27017/northeast_shipping
MONGODB_DB_NAME=northeast_shipping

# Database Fallback (When MongoDB is not available in development)
ENABLE_DB_FALLBACK=true

# Authentication & JWT Security
JWT_SECRET=2mnSzts1zE2J7nHkA4lgBV7pwu95odDLqamPm4C/CAs=
JWT_EXPIRES_IN=7d

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Document & CV Upload Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5
ALLOWED_FILE_TYPES=application/pdf,image/jpeg,image/png

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_AUTH=5
RATE_LIMIT_MAX_SUBMISSIONS=10
RATE_LIMIT_MAX_GENERAL=60

# Cloudflare R2 Object Storage (Zero-Egress S3-Compatible Storage)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=northeast-shipping-uploads
R2_PUBLIC_URL=https://pub-your_bucket_id.r2.dev

# Contact & System Email Notifications
CONTACT_NOTIFICATION_EMAIL=contact@northeastshipping.com
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@northeastshipping.com
